{
  "$schema": "shadetube-tokens/1",
  "color": {
    "dark": {
      "surface0": "#0B0C10", "surface1": "#12141A", "surface2": "#1A1D25", "surface3": "#232732",
      "outline": "#2B303C", "outlineVariant": "#1F232D",
      "text1": "#F3F1EA", "text2": "#A6AAB6", "text3": "#6E7382",
      "scrim": "#000000B3",
      "error": "#FF6B6B", "onError": "#1A0B0B", "warning": "#F0B35A", "success": "#6FCF97",
      "accentFallback": "#D8D6CF", "onAccentDark": "#0E0F13", "onAccentLight": "#FFFFFF"
    },
    "light": {
      "surface0": "#F7F6F1", "surface1": "#FFFFFF", "surface2": "#EEEDE7", "surface3": "#E3E1DA",
      "outline": "#D3D1C9", "outlineVariant": "#E6E4DD",
      "text1": "#15171D", "text2": "#5B606D", "text3": "#8A8F9C",
      "scrim": "#00000066",
      "error": "#B3261E", "onError": "#FFFFFF", "warning": "#8A5A00", "success": "#2E7D4F",
      "accentFallback": "#4A4F5C", "onAccentDark": "#0E0F13", "onAccentLight": "#FFFFFF"
    },
    "accentPresets": {
      "kehribar": "#F0B35A", "turkuaz": "#5FD4C4", "gul": "#F08CA8", "lavanta": "#9B8CE6",
      "gokyuzu": "#5B8DEF", "nane": "#58B37A", "mandalina": "#E07A3A", "mercan": "#FF7F6E",
      "limon": "#E3D15A", "buz": "#9FD8F0", "kum": "#D8C3A5", "gri": "#B8BCC8"
    },
    "accentRule": {
      "space": "OKLCH",
      "extraction": ["Palette.Vibrant", "Palette.DarkVibrant", "Palette.Muted"],
      "minCoverage": 0.08,
      "dark":  { "L": [0.72, 0.84], "Cmin": 0.06 },
      "light": { "L": [0.45, 0.58], "Cmin": 0.06 },
      "onAccent": "L > 0.60 ? onAccentDark : onAccentLight  (≥ 4.5:1 garanti)",
      "derived": {
        "accentContainer": "accent @ 18% over surface1",
        "accentGlow": "accent @ 35%, blur 40dp",
        "progressTrack": "accent @ 24%",
        "accentOutline": "accent @ 50%"
      },
      "transitionMs": 600, "transitionEasing": "fastOutSlowIn"
    }
  },
  "typography": {
    "fonts": {
      "display": { "family": "Bricolage Grotesque", "license": "OFL", "res": "bricolage_grotesque_*", "weights": [400, 500, 600, 700, 800] },
      "body":    { "family": "Instrument Sans",     "license": "OFL", "res": "instrument_sans_*",     "weights": [400, 500, 600, 700] },
      "mono":    { "family": "JetBrains Mono",      "license": "OFL", "res": "jetbrains_mono_*",      "weights": [400, 500, 600], "features": "tnum" }
    },
    "scale": {
      "displayLarge":  { "font": "display", "size": 44, "weight": 800, "lineHeight": 48, "letterSpacing": -1.5 },
      "displayMedium": { "font": "display", "size": 34, "weight": 800, "lineHeight": 38, "letterSpacing": -1.0 },
      "headlineLarge": { "font": "display", "size": 28, "weight": 700, "lineHeight": 32, "letterSpacing": -0.6 },
      "headlineMedium":{ "font": "display", "size": 24, "weight": 700, "lineHeight": 28, "letterSpacing": -0.5 },
      "headlineSmall": { "font": "display", "size": 20, "weight": 700, "lineHeight": 24, "letterSpacing": -0.3 },
      "titleLarge":    { "font": "body", "size": 17, "weight": 600, "lineHeight": 24, "letterSpacing": 0 },
      "titleMedium":   { "font": "body", "size": 15, "weight": 600, "lineHeight": 20, "letterSpacing": 0 },
      "titleSmall":    { "font": "body", "size": 14, "weight": 600, "lineHeight": 20, "letterSpacing": 0 },
      "bodyLarge":     { "font": "body", "size": 16, "weight": 400, "lineHeight": 24, "letterSpacing": 0 },
      "bodyMedium":    { "font": "body", "size": 14, "weight": 400, "lineHeight": 20, "letterSpacing": 0 },
      "bodySmall":     { "font": "body", "size": 12, "weight": 400, "lineHeight": 16, "letterSpacing": 0 },
      "labelLarge":    { "font": "body", "size": 14, "weight": 600, "lineHeight": 20, "letterSpacing": 0 },
      "labelMedium":   { "font": "body", "size": 12, "weight": 600, "lineHeight": 16, "letterSpacing": 0.1 },
      "labelSmall":    { "font": "body", "size": 11, "weight": 600, "lineHeight": 16, "letterSpacing": 0.2 },
      "monoLarge":     { "font": "mono", "size": 18, "weight": 500, "lineHeight": 24, "letterSpacing": 0 },
      "monoMedium":    { "font": "mono", "size": 13, "weight": 400, "lineHeight": 16, "letterSpacing": 0 },
      "monoSmall":     { "font": "mono", "size": 11, "weight": 500, "lineHeight": 14, "letterSpacing": 0.4 },
      "overline":      { "font": "mono", "size": 10, "weight": 500, "lineHeight": 14, "letterSpacing": 1.2, "uppercase": true }
    },
    "unit": "sp"
  },
  "spacing": { "unit": "dp", "grid": 4, "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "xxxl": 32, "section": 24, "screenEdge": 20, "listRow": 60, "miniPlayer": 64, "navBar": 80 },
  "radius": { "unit": "dp", "cover": 6, "chip": 10, "card": 12, "panel": 20, "sheetTop": 28, "sheetBottom": 0, "pill": 999, "phoneCorner": 36 },
  "elevation": {
    "unit": "dp",
    "level0": { "dp": 0, "surface": "surface0" },
    "level1": { "dp": 1, "surface": "surface1", "shadowAlpha": 0.00 },
    "level2": { "dp": 3, "surface": "surface2", "shadowAlpha": 0.20 },
    "level3": { "dp": 6, "surface": "surface3", "shadowAlpha": 0.28 },
    "miniPlayer": { "dp": 8, "surface": "surface3 @ 90% + blur 20dp", "glow": "accentGlow" },
    "sheet": { "dp": 12, "surface": "surface2", "scrim": "scrim" }
  },
  "motion": {
    "duration": { "instant": 100, "short": 150, "standard": 250, "medium": 400, "long": 600, "accentShift": 600 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.05, 0.7, 0.1, 1)",
      "emphasizedAccelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)",
      "linear": "linear"
    },
    "spring": {
      "dragRelease": { "dampingRatio": 0.8, "stiffness": 380 },
      "sheetSnap": { "dampingRatio": 0.85, "stiffness": 300 },
      "heartPop": { "dampingRatio": 0.45, "stiffness": 600 }
    },
    "reduceMotion": "glow, sharedElement ve spring kapanır; yalnızca 150 ms fade"
  },
  "size": { "unit": "dp", "touchMin": 48, "icon": 24, "iconSmall": 16, "avatar": 40, "coverRow": 44, "coverMini": 48, "coverTile": 132, "coverHero": 148, "coverNowPlaying": 348, "playButton": 76, "chipHeight": 36, "buttonHeight": 48, "navIndicator": "64x32" }
}
